# Service
PORT=8080
DATA_DIR=/data
PUBLIC_BASE_URL=https://the-ai-edge.example.com
API_TOKEN=

# Research sources (comma separated RSS/Atom feeds)
RSS_FEEDS=https://openai.com/blog/rss.xml,https://www.anthropic.com/rss.xml,https://blogs.microsoft.com/ai/feed/,https://news.ycombinator.com/rss
RESEARCH_WINDOW_HOURS=96
MAX_ITEMS_PER_FEED=15

# AI agents
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Show format
HOST_A_NAME=Maya
HOST_B_NAME=Daan
TARGET_EPISODE_MINUTES=12

# Text to speech
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_ID_HOST_A=
VOICE_ID_HOST_B=
INTRO_MUSIC_FILE=
OUTRO_MUSIC_FILE=

# Podcast host
TRANSISTOR_API_KEY=
TRANSISTOR_SHOW_ID=

# Review + confirmation notifications (Slack-compatible incoming webhook)
NOTIFY_WEBHOOK_URL=
